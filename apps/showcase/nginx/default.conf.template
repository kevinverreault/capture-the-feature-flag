# The showcase's nginx server. The image renders this template at startup (envsubst on the variables that are set,
# so nginx's own $variables stay as they are): PORT is the port to listen on.

# One JSON object per request, like the other services' logs.
log_format json escape=json '{"time":"$time_iso8601","method":"$request_method","url":"$request_uri",'
                            '"status":$status,"bytes":$body_bytes_sent,"responseTimeS":$request_time,'
                            '"remoteAddress":"$remote_addr","userAgent":"$http_user_agent"}';

server {
  listen ${PORT};
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;
  # Redirects (/quickstart → /quickstart/) keep the host and port the browser used, behind any port mapping.
  absolute_redirect off;
  access_log /dev/stdout json;

  # For the container's health check: nginx is up and serving.
  location = /health {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  # Astro's bundled assets have content hashes in their names, so they never change.
  location /_astro/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location / {
    try_files $uri $uri/ =404;
  }

  error_page 404 /404.html;
}
