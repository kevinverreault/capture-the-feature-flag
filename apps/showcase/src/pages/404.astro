---
import Button from '@ds/components/ui/Button.astro';
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Not found" description="There is no page at this address.">
  <section class="section">
    <h1 class="ff-serif text-3xl">Nothing to see here</h1>
    <p>There is no page at this address.</p>
    <div class="actions">
      <Button href="/" variant="primary">Back to the home page</Button>
    </div>
  </section>
</SiteLayout>
