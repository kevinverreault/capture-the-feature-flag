---
import '@styles/global.css';
import '../styles/showcase.css';
import Footer from '@ds/components/navigation/Footer.astro';
import NavigationMenu from '@ds/components/navigation/NavigationMenu.astro';
import ThemeToggle from '@ds/components/ui/ThemeToggle.astro';
import { pages, productName } from '../lib/site';

interface Props {
  title: string;
  /** One sentence about the page, for search engines and link previews. */
  description: string;
}

const { title, description } = Astro.props;
const pageTitle = Astro.url.pathname === '/' ? productName : `${title} · ${productName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body class="ff-sans-normal">
    <header class="site-header">
      <div class="site-bar">
        <a href="/" class="brand ff-serif text-xl">{productName}</a>
        <ThemeToggle />
      </div>
      <NavigationMenu navigationItems={[...pages]} />
    </header>
    <main class="site-main">
      <slot />
    </main>
    <Footer
      groups={(['Product', 'Guides'] as const).map((group) => ({
        title: group,
        links: pages.filter((page) => page.group === group),
      }))}
      copyright="2026 Kevin Verreault. Capture The Feature Flag is MIT licensed."
      navigationLabel="Site"
    />
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    background-color: hsl(var(--color-background));
    color: hsl(var(--color-on-background));
  }

  .site-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
  }

  .brand {
    color: inherit;
    text-decoration: none;
  }

  .site-main {
    flex: 1;
    display: grid;
    gap: var(--space-lg);
    width: 100%;
    max-width: var(--container-max-width);
    box-sizing: border-box;
    margin-inline: auto;
    padding: var(--space-md);
  }
</style>
