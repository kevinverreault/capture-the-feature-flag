---
import Button from '@ds/components/ui/Button.astro';
import { routes } from '../lib/routes';
---

<section class="not-found">
  <h1 class="ff-serif text-2xl">Not found</h1>
  <p><slot /></p>
  <Button href={routes.projects()} variant="primary">See all projects</Button>
</section>

<style>
  h1 {
    margin: 0;
  }

  .not-found {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }
</style>
