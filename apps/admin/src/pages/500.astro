---
import Button from '@ds/components/ui/Button.astro';
import AdminLayout from '../layouts/AdminLayout.astro';
import { routes } from '../lib/routes';

// The middleware rewrites here when a page fails. Core may be what failed, so this page doesn't call it.
Astro.response.status = 500;
---

<AdminLayout title="Something went wrong" projects={[]}>
  <section class="stack">
    <h1 class="ff-serif text-2xl">Something went wrong</h1>
    <p>The admin app could not load this page from Core. Core may be unavailable; try again in a moment.</p>
    <Button href={routes.projects()} variant="primary">Back to projects</Button>
  </section>
</AdminLayout>
