---
import { unwrap } from '@ctff/core-api-client';
import FormField from '@ds/components/form/FormField.astro';
import Input from '@ds/components/form/Input.astro';
import Button from '@ds/components/ui/Button.astro';
import ConfirmDelete from '../../../components/ConfirmDelete.astro';
import FormAlert from '../../../components/FormAlert.astro';
import NotFound from '../../../components/NotFound.astro';
import ProjectNav from '../../../components/ProjectNav.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { coreApi } from '../../../lib/core';
import { setFlash } from '../../../lib/flash';
import { noFormErrors } from '../../../lib/form-errors';
import { orNotFound, submit, textField } from '../../../lib/forms';

const core = coreApi(Astro.locals);
const projectKey = Astro.params.project ?? '';
const path = { path: { projectKey } };
let name: string | undefined;
let errors = noFormErrors;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (textField(form, '_action') === 'delete') {
    const deleted = await submit(() => unwrap(core.DELETE('/api/v1/projects/{projectKey}', { params: path })), []);
    if (deleted.ok) {
      setFlash(Astro.cookies, `Project ${projectKey} deleted`);
      return Astro.redirect('/projects', 303);
    }
    errors = deleted.errors;
    Astro.response.status = deleted.status;
  } else {
    name = textField(form, 'name');
    const renamed = await submit(
      () => unwrap(core.PATCH('/api/v1/projects/{projectKey}', { params: path, body: { name } })),
      ['name'],
    );
    if (renamed.ok) {
      setFlash(Astro.cookies, `Project renamed to ${renamed.value.name}`);
      return Astro.redirect(`/projects/${renamed.value.key}/settings`, 303);
    }
    errors = renamed.errors;
    Astro.response.status = renamed.status;
  }
}

const [projects, project] = await Promise.all([
  unwrap(core.GET('/api/v1/projects')),
  orNotFound(unwrap(core.GET('/api/v1/projects/{projectKey}', { params: path }))),
]);
if (!project) Astro.response.status = 404;
---

{
  project ? (
    <AdminLayout title={`Settings · ${project.name}`} projects={projects} project={project}>
      <ProjectNav project={project} current="settings" />

      <section aria-labelledby="rename-project">
        <h2 id="rename-project" class="text-xl">
          Rename
        </h2>
        <form method="post" class="stack">
          <input type="hidden" name="_action" value="rename" />
          <FormAlert messages={errors.form} />
          <FormField label="Name" error={errors.fields['name']}>
            <Input name="name" value={name ?? project.name} required />
          </FormField>
          <FormField label="Key" hint="A project's key cannot be changed.">
            <Input value={project.key} readonly disabled />
          </FormField>
          <Button type="submit" variant="primary">
            Save
          </Button>
        </form>
      </section>

      <section aria-labelledby="delete-project" class="danger-zone">
        <h2 id="delete-project" class="text-xl">
          Delete this project
        </h2>
        <p>Deletes its environments, their SDK keys, its flags and all their targeting.</p>
        <ConfirmDelete
          title={`Delete the ${project.name} project?`}
          description="Its environments, their SDK keys, its flags and all their targeting are deleted with it. This cannot be undone."
          actionLabel="Delete project"
        />
      </section>
    </AdminLayout>
  ) : (
    <AdminLayout title="Project not found" projects={projects}>
      <NotFound>There is no project {projectKey}.</NotFound>
    </AdminLayout>
  )
}
