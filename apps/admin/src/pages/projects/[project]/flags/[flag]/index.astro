---
import { unwrap } from '@ctff/core-api-client';
import Switch from '@ds/components/form/Switch.astro';
import TabPanel from '@ds/components/navigation/TabPanel.astro';
import Tabs from '@ds/components/navigation/Tabs.astro';
import Badge from '@ds/components/ui/Badge.astro';
import Button from '@ds/components/ui/Button.astro';
import AuditEntries from '../../../../../components/AuditEntries.astro';
import ChangedElsewhere from '../../../../../components/ChangedElsewhere.astro';
import ConfirmDelete from '../../../../../components/ConfirmDelete.astro';
import FormAlert from '../../../../../components/FormAlert.astro';
import NotFound from '../../../../../components/NotFound.astro';
import ProjectNav from '../../../../../components/ProjectNav.astro';
import TargetingEditor from '../../../../../components/TargetingEditor.astro';
import AdminLayout from '../../../../../layouts/AdminLayout.astro';
import { flagVariations } from '../../../../../lib/audit';
import { coreApi } from '../../../../../lib/core';
import { noFormErrors } from '../../../../../lib/form-errors';
import { type FormAction, handlePost, orNotFound, textField } from '../../../../../lib/forms';
import { routes } from '../../../../../lib/routes';
import {
  readTargetingDraft,
  targetingChange,
  targetingChangeFields,
  targetingDraft,
  targetingDraftErrors,
} from '../../../../../lib/targeting-form';

const core = coreApi(Astro.locals);
const projectKey = Astro.params.project ?? '';
const flagKey = Astro.params.flag ?? '';
const params = { path: { projectKey, flagKey } };
/** A form that archives, restores or deletes the whole flag, then goes to `location` with `flash`. */
const flagAction = (call: () => Promise<unknown>, location: string, flash: string): FormAction => ({
  fields: [],
  send: async () => {
    await call();
    return { location, flash };
  },
});
/** Saves a targeting change to one environment, then goes back to its tab, saying what was done there. */
async function saveTargeting(
  environmentKey: string,
  body: { version: number; on?: boolean } & Partial<ReturnType<typeof targetingChange>>,
  done: (on: boolean) => string,
) {
  const targeting = await unwrap(
    core.PATCH('/api/v1/projects/{projectKey}/flags/{flagKey}/targeting/{environmentKey}', {
      params: { path: { projectKey, flagKey, environmentKey } },
      body,
    }),
  );
  const environment = await unwrap(
    core.GET('/api/v1/projects/{projectKey}/environments/{environmentKey}', {
      params: { path: { projectKey, environmentKey } },
    }),
  );
  return {
    location: routes.flag(projectKey, flagKey, targeting.environmentKey),
    flash: `${done(targeting.on)} in ${environment.name}`,
  };
}
const post = await handlePost(Astro, {
  'edit-targeting': {
    fields: targetingChangeFields,
    versioned: true,
    send: async (form) => {
      const { variations } = await unwrap(core.GET('/api/v1/projects/{projectKey}/flags/{flagKey}', { params }));
      const change = targetingChange(readTargetingDraft(form, variations.length));
      return saveTargeting(
        textField(form, 'environment'),
        { version: Number(textField(form, 'version')), ...change },
        () => 'Targeting saved',
      );
    },
  },
  targeting: {
    fields: ['on'],
    versioned: true,
    send: (form) =>
      saveTargeting(
        textField(form, 'environment'),
        { version: Number(textField(form, 'version')), on: form.has('on') },
        (on) => `Targeting switched ${on ? 'on' : 'off'}`,
      ),
  },
  archive: flagAction(
    () => unwrap(core.POST('/api/v1/projects/{projectKey}/flags/{flagKey}/archive', { params })),
    routes.flag(projectKey, flagKey),
    `Flag ${flagKey} archived`,
  ),
  restore: flagAction(
    () => unwrap(core.POST('/api/v1/projects/{projectKey}/flags/{flagKey}/restore', { params })),
    routes.flag(projectKey, flagKey),
    `Flag ${flagKey} restored`,
  ),
  delete: flagAction(
    () => unwrap(core.DELETE('/api/v1/projects/{projectKey}/flags/{flagKey}', { params })),
    routes.flags(projectKey),
    `Flag ${flagKey} deleted`,
  ),
});
if (post.redirect) return post.redirect;

/** How many of the flag's newest audit entries the page shows; the audit log has the rest. */
const auditEntriesShown = 10;
const [projects, project, environments, flag, targeting, auditEntries] = await Promise.all([
  unwrap(core.GET('/api/v1/projects')),
  orNotFound(unwrap(core.GET('/api/v1/projects/{projectKey}', { params: { path: { projectKey } } }))),
  orNotFound(unwrap(core.GET('/api/v1/projects/{projectKey}/environments', { params: { path: { projectKey } } }))),
  orNotFound(unwrap(core.GET('/api/v1/projects/{projectKey}/flags/{flagKey}', { params }))),
  orNotFound(unwrap(core.GET('/api/v1/projects/{projectKey}/flags/{flagKey}/targeting', { params }))),
  unwrap(core.GET('/api/v1/audit-entries', { params: { query: { projectKey, flagKey, limit: auditEntriesShown } } })),
]);
if (!project || !environments || !flag || !targeting) Astro.response.status = 404;

const targetingActions = ['targeting', 'edit-targeting'];
/** The environment whose targeting switch or editor was just submitted and rejected, if any. */
const postedEnvironment = targetingActions.includes(post.action ?? '') ? post.value('environment') : undefined;
const variations = flag?.variations.map(String) ?? [];
const tabs = environments?.flatMap((environment) => {
  const current = targeting?.find((row) => row.environmentKey === environment.key);
  if (!current) return [];
  const posted = environment.key === postedEnvironment;
  const switched = posted && post.action === 'targeting';
  const editedForm = posted && post.action === 'edit-targeting' ? post.form : undefined;
  const edited = editedForm !== undefined;
  // A rejected change keeps what was submitted, and the version it was based on (see ChangedElsewhere).
  const draft = editedForm
    ? readTargetingDraft(editedForm, variations.length)
    : targetingDraft(current, variations.length);
  const currentVersion = String(current.version);
  return [
    {
      environment,
      on: switched ? post.value('on') !== undefined : current.on,
      offVariation: variations[current.offVariation],
      switchVersion: switched ? (post.value('version') ?? currentVersion) : currentVersion,
      switchErrors: switched ? post.errors : noFormErrors,
      draft,
      editorVersion: edited ? (post.value('version') ?? currentVersion) : currentVersion,
      editorErrors: edited ? post.errors : noFormErrors,
      editorFieldErrors: edited ? targetingDraftErrors(post.errors.fields, draft) : undefined,
    },
  ];
});
// A rejected change for an environment without a tab (deleted since the page loaded) shows above the tabs.
const unplaced = postedEnvironment !== undefined && !tabs?.some((tab) => tab.environment.key === postedEnvironment);
const unplacedMessages = unplaced
  ? [...post.errors.form, ...Object.values(post.errors.fields).filter((message) => message !== undefined)]
  : [];
/**
 * Why a submission was rejected, shown above the flag's sections rather than in a targeting tab: Core's refusal
 * to archive, restore or delete the flag (e.g. deleting a flag restored since the page was loaded), or a targeting
 * switch flipped on a page loaded before the flag was archived (an archived flag shows no targeting tabs).
 */
const flagMessages =
  targetingActions.includes(post.action ?? '')
    ? flag?.archived
      ? ['This flag was archived since this page was loaded, so the targeting change was not saved.']
      : []
    : post.errors.form;
---

{
  project && environments && flag && tabs ? (
    <AdminLayout title={`${flag.name} · ${project.name}`} projects={projects} project={project}>
      <ProjectNav project={project} current="flags" />

      <section aria-labelledby="flag-heading" class="flag-summary">
        <div class="section-heading">
          <h2 id="flag-heading" class="text-xl">
            {flag.name}
          </h2>
          {flag.archived ? (
            <Badge variant="muted">Archived</Badge>
          ) : (
            <Button href={routes.editFlag(project.key, flag.key)} variant="secondary" size="small">
              Edit details
            </Button>
          )}
        </div>
        <p>
          Key <code>{flag.key}</code>
        </p>
        {flag.description && <p class="description">{flag.description}</p>}
        {flag.tags.length > 0 && (
          <p class="tag-list" aria-label="Tags">
            {flag.tags.map((tag) => (
              <Badge variant="outline">{tag}</Badge>
            ))}
          </p>
        )}
      </section>

      <FormAlert messages={flagMessages} />

      {flag.archived ? (
        <section aria-labelledby="archived-heading" class="danger-zone">
          <h2 id="archived-heading" class="text-xl">
            This flag is archived
          </h2>
          <p>
            It is hidden from the flag list and not served: SDKs get their fallback value for it. Restoring it serves
            its targeting in every environment again, as it was when it was archived.
          </p>
          <div class="lifecycle-actions">
            <form method="post">
              <input type="hidden" name="_action" value="restore" />
              <Button type="submit" variant="primary">
                Restore flag
              </Button>
            </form>
            <ConfirmDelete
              title={`Permanently delete ${flag.name}?`}
              description={`The flag ${flag.key} and its targeting in every environment are deleted. This cannot be undone.`}
              actionLabel="Delete flag"
            />
          </div>
        </section>
      ) : (
        <>
          <section aria-labelledby="targeting-heading" class="targeting">
            <h2 id="targeting-heading" class="text-xl">
              Targeting
            </h2>
            <FormAlert messages={unplacedMessages} />
            {tabs.length === 0 ? (
              <p>
                This project has no environments yet: <a href={routes.environments(project.key)}>create one</a> to
                switch this flag's targeting on in it.
              </p>
            ) : (
              <flag-tabs data-selected={Astro.url.searchParams.get('environment') ?? postedEnvironment ?? ''}>
                <Tabs label="Environments">
                  {tabs.map(
                    ({
                      environment,
                      on,
                      offVariation,
                      switchVersion,
                      switchErrors,
                      draft,
                      editorVersion,
                      editorErrors,
                      editorFieldErrors,
                    }) => (
                    <TabPanel label={environment.name} data-environment={environment.key}>
                      {switchErrors.changedElsewhere && (
                        <ChangedElsewhere
                          what={`the targeting in ${environment.name}`}
                          reloadHref={routes.flag(project.key, flag.key, environment.key)}
                        />
                      )}
                      <FormAlert messages={switchErrors.form} />
                      <form method="post" class="targeting-switch">
                        <input type="hidden" name="_action" value="targeting" />
                        <input type="hidden" name="environment" value={environment.key} />
                        <input type="hidden" name="version" value={switchVersion} />
                        <label class="switch-label">
                          <Switch name="on" checked={on} aria-describedby={`served-${environment.key}`} />
                          Targeting {on ? 'on' : 'off'} in {environment.name}
                          {switchErrors.changedElsewhere && ' (not saved)'}
                        </label>
                        <p id={`served-${environment.key}`} class="served">
                          {on
                            ? 'Individual targets and rules decide what each context gets, then the default variation.'
                            : `Every context gets the off variation, ${offVariation}.`}
                        </p>
                        <noscript>
                          <Button type="submit" variant="primary" size="small">
                            Save
                          </Button>
                        </noscript>
                      </form>
                      {editorErrors.changedElsewhere && (
                        <ChangedElsewhere
                          what={`the targeting in ${environment.name}`}
                          reloadHref={routes.flag(project.key, flag.key, environment.key)}
                        />
                      )}
                      <FormAlert messages={editorErrors.form} />
                      <TargetingEditor
                        environmentKey={environment.key}
                        version={editorVersion}
                        variations={variations}
                        draft={draft}
                        errors={editorFieldErrors}
                      />
                    </TabPanel>
                    ),
                  )}
                </Tabs>
              </flag-tabs>
            )}
          </section>

          <section aria-labelledby="archive-heading" class="danger-zone">
            <h2 id="archive-heading" class="text-xl">
              Archive this flag
            </h2>
            <p>
              Once its code no longer reads it, archive it: it is hidden from the flag list and no longer served, so
              SDKs get their fallback value. Its targeting is kept, and it can be restored. Only an archived flag can
              be deleted.
            </p>
            <form method="post">
              <input type="hidden" name="_action" value="archive" />
              <Button type="submit" variant="danger" decoration="outline">
                Archive flag
              </Button>
            </form>
          </section>
        </>
      )}

      <section aria-labelledby="audit-entries" class="flag-audit">
        <h2 id="audit-entries" class="text-xl">
          Audit entries
        </h2>
        <AuditEntries
          entries={auditEntries.entries}
          flags={flagVariations([flag])}
          olderHref={auditEntries.nextCursor === null ? undefined : routes.audit(project.key, { flag: flag.key, cursor: auditEntries.nextCursor })}
          empty="No changes yet."
        />
      </section>

      <Button href={routes.flags(project.key)} variant="muted" decoration="ghost">
        Back to flags
      </Button>
    </AdminLayout>
  ) : (
    <AdminLayout title="Flag not found" projects={projects} project={project}>
      <NotFound>
        There is no flag {flagKey} in project {project?.name ?? projectKey}.
      </NotFound>
    </AdminLayout>
  )
}

<script>
  /**
   * Opens the tab of the environment named in the address (after a save, the one just changed), keeps the
   * address in step as tabs are picked, and saves a targeting switch as soon as it is flipped.
   */
  class FlagTabs extends HTMLElement {
    async connectedCallback() {
      for (const input of this.querySelectorAll<HTMLInputElement>('.targeting-switch input[role="switch"]')) {
        input.addEventListener('change', () => input.form?.requestSubmit());
      }

      await customElements.whenDefined('tab-group');
      const group = this.querySelector<HTMLElement & { select(index: number): void }>('tab-group');
      if (!group) return;
      const panels = [...group.querySelectorAll<HTMLElement>(':scope > .tab-panel')];
      const selected = panels.findIndex((panel) => panel.dataset['environment'] === this.dataset['selected']);
      if (selected > 0) group.select(selected);

      // However a tab is picked (click or arrow keys), it shows its panel: follow that.
      new MutationObserver(() => {
        const shown = panels.find((panel) => !panel.hidden)?.dataset['environment'];
        if (!shown) return;
        const url = new URL(window.location.href);
        if (url.searchParams.get('environment') === shown) return;
        url.searchParams.set('environment', shown);
        history.replaceState(history.state, '', url);
      }).observe(group, { subtree: true, attributeFilter: ['hidden'] });
    }
  }
  customElements.define('flag-tabs', FlagTabs);
</script>

<style>
  .flag-summary,
  .targeting,
  .flag-audit {
    display: grid;
    gap: var(--space-xs);
  }

  .flag-summary p {
    margin: 0;
  }

  .description {
    white-space: pre-line;
  }

  .targeting-switch {
    display: grid;
    gap: var(--space-xs);
    justify-items: start;
  }

  .switch-label {
    display: inline-flex;
    gap: var(--space-xs);
    align-items: center;
    font-weight: 700;
    cursor: pointer;
  }

  .served {
    margin: 0;
    color: hsl(var(--color-on-background) / 0.75);
  }

  flag-tabs {
    display: block;
  }

  .lifecycle-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
