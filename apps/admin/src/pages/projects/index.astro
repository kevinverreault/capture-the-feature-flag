---
import { unwrap } from '@ctff/core-api-client';
import FormField from '@ds/components/form/FormField.astro';
import Input from '@ds/components/form/Input.astro';
import Button from '@ds/components/ui/Button.astro';
import Card from '@ds/components/ui/Card.astro';
import FormAlert from '../../components/FormAlert.astro';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { coreApi } from '../../lib/core';
import { handlePost, textField } from '../../lib/forms';
import { routes } from '../../lib/routes';

const core = coreApi(Astro.locals);
const post = await handlePost(Astro, {
  create: {
    fields: ['key', 'name'],
    conflictField: 'key',
    send: async (form) => {
      const body = { key: textField(form, 'key'), name: textField(form, 'name') };
      const project = await unwrap(core.POST('/api/v1/projects', { body }));
      return { location: routes.project(project.key), flash: `Project ${project.name} created` };
    },
  },
});
if (post.redirect) return post.redirect;
const errors = post.errors;

const projects = await unwrap(core.GET('/api/v1/projects'));
---

<AdminLayout title="Projects" projects={projects}>
  <h1 class="ff-serif text-2xl">Projects</h1>

  <section aria-labelledby="project-list">
    <h2 id="project-list" class="text-xl">All projects</h2>
    {
      projects.length === 0 ? (
        <p>No projects yet. Create the first one below.</p>
      ) : (
        <ul class="cards">
          {projects.map((project) => (
            <li>
              <Card href={routes.project(project.key)}>
                <strong slot="header">{project.name}</strong>
                <code>{project.key}</code>
              </Card>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section aria-labelledby="create-project">
    <h2 id="create-project" class="text-xl">Create a project</h2>
    <form method="post" class="stack">
      <FormAlert messages={errors.form} />
      <FormField label="Name" error={errors.fields['name']}>
        <Input name="name" value={post.value('name') ?? ''} required />
      </FormField>
      <FormField
        label="Key"
        hint="Lowercase kebab-case, such as birdwatch. It cannot be changed later."
        error={errors.fields['key']}
      >
        <Input name="key" value={post.value('key') ?? ''} required />
      </FormField>
      <Button type="submit" variant="primary">Create project</Button>
    </form>
  </section>
</AdminLayout>

