---
import { unwrap } from '@ctff/core-api-client';
import FormField from '@ds/components/form/FormField.astro';
import Input from '@ds/components/form/Input.astro';
import Button from '@ds/components/ui/Button.astro';
import AdminLayout from '../layouts/AdminLayout.astro';
import { coreApi } from '../lib/core';
import { displayName, displayNameMaxLength, returnPath, setDisplayName } from '../lib/display-name';
import { setFlash } from '../lib/flash';
import { textField } from '../lib/forms';
import { routes } from '../lib/routes';

// Setting the display name only touches this browser's cookie: nothing is sent to Core.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const name = setDisplayName(Astro.cookies, textField(form, 'name'));
  setFlash(
    Astro.cookies,
    name === '' ? 'Display name cleared: changes are now recorded as anonymous' : `Changes are now recorded as ${name}`,
  );
  return Astro.redirect(returnPath(textField(form, 'returnTo'), routes.projects()), 303);
}

const core = coreApi(Astro.locals);
const projects = await unwrap(core.GET('/api/v1/projects'));
const returnTo = returnPath(Astro.url.searchParams.get('returnTo'), routes.projects());
const current = displayName(Astro.cookies) ?? '';
---

<AdminLayout title="Display name" projects={projects}>
  <h1 class="ff-serif text-2xl">Display name</h1>
  <p>
    The audit log records who made each change. Changes you make in this browser are recorded under this name, or
    as <em>anonymous</em> without one. It is kept in a cookie: there are no accounts.
  </p>
  <form method="post" class="stack">
    <input type="hidden" name="returnTo" value={returnTo} />
    <FormField label="Display name" hint="Leave it empty to make changes as anonymous.">
      <Input name="name" value={current} maxlength={displayNameMaxLength} autocomplete="name" />
    </FormField>
    <Button type="submit" variant="primary">Save</Button>
  </form>
  <Button href={returnTo} variant="muted" decoration="ghost">Back</Button>
</AdminLayout>
