generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  importFileExtension    = "js"
  generatedFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model Project {
  id           String        @id @default(uuid()) @db.Uuid
  key          String        @unique
  name         String
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  environments Environment[]
  flags        Flag[]

  @@map("projects")
}

model Environment {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id") @db.Uuid
  key       String
  name      String
  sdkKey    String      @unique @map("sdk_key")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targeting Targeting[]

  @@unique([projectId, key])
  @@map("environments")
}

model Flag {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  key         String
  name        String
  description String      @default("")
  tags        String[]    @default([])
  /// The ordered list of variations; boolean flags always have [true, false] (ADR 0002).
  variations  Json
  version     Int         @default(1)
  /// The tool managing the flag as code, or null when it is managed by hand.
  managedBy   ManagedBy?  @map("managed_by")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  targeting   Targeting[]

  @@unique([projectId, key])
  @@map("flags")
}

/// The tools that can manage a flag as code. V1 has one: the Terraform provider.
enum ManagedBy {
  terraform
}

/// The targeting of one flag in one environment. Variations are referred to by index into Flag.variations.
model Targeting {
  id                String      @id @default(uuid()) @db.Uuid
  flagId            String      @map("flag_id") @db.Uuid
  environmentId     String      @map("environment_id") @db.Uuid
  on                Boolean     @default(false)
  offVariation      Int         @map("off_variation")
  defaultVariation  Int         @map("default_variation")
  individualTargets Json        @default("[]") @map("individual_targets")
  rules             Json        @default("[]")
  version           Int         @default(1)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  flag              Flag        @relation(fields: [flagId], references: [id], onDelete: Cascade)
  environment       Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@unique([flagId, environmentId])
  @@index([environmentId])
  @@map("targeting")
}

/// What an audit entry is about.
enum AuditTargetType {
  project
  environment
  flag
  targeting
}

/// What was done to an audit entry's target.
enum AuditAction {
  create
  update
  archive
  restore
  delete
}

/// A record of one change to a project, environment, flag or targeting: who made it, when, and what changed.
/// Entries outlive what they are about, so the ids and keys are copied in, not foreign keys.
model AuditEntry {
  /// Increases with every entry, in the order entries are committed (see recordAudit), so it orders entries
  /// newest first and serves as the pagination cursor.
  id             Int             @id @default(autoincrement())
  projectId      String          @map("project_id") @db.Uuid
  projectKey     String          @map("project_key")
  targetType     AuditTargetType @map("target_type")
  /// The id of the project, environment, flag or targeting row the entry is about.
  targetId       String          @map("target_id") @db.Uuid
  /// The flag of a flag or targeting entry, so a flag's history includes its targeting.
  flagId         String?         @map("flag_id") @db.Uuid
  flagKey        String?         @map("flag_key")
  /// The environment of an environment or targeting entry.
  environmentKey String?         @map("environment_key")
  action         AuditAction
  actor          String
  /// The target as it was before the change (null for a create) and after it (null for a delete).
  before         Json?
  after          Json?
  /// When the entry was recorded: the clock time, not the transaction's start, so it follows the id's order.
  createdAt      DateTime        @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)

  @@index([projectKey, id])
  @@index([projectKey, flagKey, id])
  @@map("audit_entries")
}
