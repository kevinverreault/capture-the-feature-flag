---
import Card from '@ds/components/ui/Card.astro';
import RarityBadge from '../../components/RarityBadge.astro';
import BirdwatchLayout from '../../layouts/BirdwatchLayout.astro';
import { speciesHref } from '../../lib/format';
import { asBirder } from '../../lib/page-session';

// Every species of the mock data, each linking to its page.
const page = await asBirder(Astro, (api) => api.species());
if ('redirect' in page) return page.redirect;
const { species } = page.loaded;
---

<BirdwatchLayout title="Species" page={page.loaded}>
  <h1 class="ff-serif text-2xl">Species</h1>
  <ul class="cards">
    {
      species.map((bird) => (
        <Card as="li" data-testid="species">
          <div slot="header">
            <div class="title-row">
              <h2 class="text-lg">
                <a href={speciesHref(bird.id)}>{bird.commonName}</a>
              </h2>
              <RarityBadge rarity={bird.rarity} />
            </div>
            <p class="muted text-sm">
              <em>{bird.scientificName}</em> · {bird.family}
            </p>
          </div>
          <p>{bird.description}</p>
        </Card>
      ))
    }
  </ul>
</BirdwatchLayout>
