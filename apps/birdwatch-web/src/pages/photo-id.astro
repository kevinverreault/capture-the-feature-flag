---
import Alert from '@ds/components/feedback/Alert.astro';
import FormField from '@ds/components/form/FormField.astro';
import Input from '@ds/components/form/Input.astro';
import Button from '@ds/components/ui/Button.astro';
import BirdwatchLayout from '../layouts/BirdwatchLayout.astro';
import { birdwatchFlags } from '@ctff/birdwatch-contract';
import { flagOn, type Species } from '../lib/api';
import { postedFormWithin } from '../lib/forms';
import { asBirder } from '../lib/page-session';
import { suggestSpecies } from '../lib/photo-id';
import { speciesHref } from '../lib/format';

// "Photo ID (beta)", for the birders photo-id-beta targets: pick a photo, get a species. It is a mock (see
// suggestSpecies); while photo-id-beta serves false, the page answers 404.
const maxPhotoBytes = 5 * 1024 * 1024;
/** Room in a posted form for the multipart boundaries and headers around the photo. */
const formOverheadBytes = 64 * 1024;
const tooLarge = 'That photo is too large: 5 MB at most.';

const page = await asBirder(Astro, (api) => api.species());
if ('redirect' in page) return page.redirect;
const { species, flags } = page.loaded;
const betaOn = flagOn(flags, birdwatchFlags.photoIdBeta);
if (!betaOn) Astro.response.status = 404;

let suggestion: Species | undefined;
let error: string | undefined;
if (betaOn && Astro.request.method === 'POST') {
  // Reads at most the photo's limit (and the form around it), so a large upload is refused before it is all in memory.
  const form = await postedFormWithin(Astro.request, maxPhotoBytes + formOverheadBytes);
  const photo = form === 'too-large' ? undefined : form.get('photo');
  if (form === 'too-large') error = tooLarge;
  else if (!(photo instanceof File) || photo.size === 0) error = 'Choose a photo first.';
  else if (photo.size > maxPhotoBytes) error = tooLarge;
  else {
    suggestion = suggestSpecies(new Uint8Array(await photo.arrayBuffer()), species);
    if (!suggestion) error = 'Birdwatch has no species to suggest from right now.';
  }
  if (!suggestion) Astro.response.status = error === tooLarge ? 413 : 400;
}
---

<BirdwatchLayout title="Photo ID (beta)" page={page.loaded}>
  <h1 class="ff-serif text-2xl">Photo ID (beta)</h1>
  {
    betaOn ? (
      <>
        <p>Pick a photo of a bird, and Birdwatch suggests a species. It is a beta, for the birders invited to try it.</p>
        {suggestion && (
          <Alert variant="success" icon="circle-check" title="It looks like…" data-testid="photo-id-suggestion">
            <a href={speciesHref(suggestion.id)}>{suggestion.commonName}</a> (
            <em>{suggestion.scientificName}</em>). This is a demo: the suggestion comes from the photo's bytes, not a
            model.
          </Alert>
        )}
        <form method="post" enctype="multipart/form-data" class="stack" data-testid="photo-id-form">
          <FormField label="Photo" error={error}>
            <Input name="photo" type="file" accept="image/*" required />
          </FormField>
          <Button type="submit" variant="primary">
            Identify
          </Button>
        </form>
      </>
    ) : (
      <Alert variant="warning" icon="triangle-alert" title="Photo ID isn't available to you" data-testid="photo-id-off">
        The photo-id-beta flag serves false for you right now.
      </Alert>
    )
  }
  <Button href="/" variant="muted" decoration="ghost">Back to the sightings</Button>
</BirdwatchLayout>
