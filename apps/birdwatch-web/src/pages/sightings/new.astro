---
import Alert from '@ds/components/feedback/Alert.astro';
import FormField from '@ds/components/form/FormField.astro';
import Input from '@ds/components/form/Input.astro';
import Select from '@ds/components/form/Select.astro';
import Textarea from '@ds/components/form/Textarea.astro';
import Button from '@ds/components/ui/Button.astro';
import BirdwatchLayout from '../../layouts/BirdwatchLayout.astro';
import { ApiError, flagOn, type NewSighting } from '../../lib/api';
import { asBirder } from '../../lib/page-session';

// "Log a sighting", behind the new-sighting-form kill switch. While it serves false, the form is gone, and
// birdwatch-api answers 404 to a post made from a page loaded before the switch.
const field = (form: FormData, name: string): string => {
  const value = form.get(name);
  return typeof value === 'string' ? value : '';
};

let submitted: NewSighting = { speciesId: '', location: '', count: '1', notes: '' };
let errors: Record<string, string> = {};
let switchedOff = false;

const page = await asBirder(Astro, async (api) => {
  if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    submitted = {
      speciesId: field(form, 'speciesId'),
      location: field(form, 'location'),
      count: field(form, 'count'),
      notes: field(form, 'notes'),
    };
    try {
      await api.logSighting(submitted);
      return { logged: true } as const;
    } catch (error) {
      if (!(error instanceof ApiError) || (error.status !== 400 && error.status !== 404)) throw error;
      if (error.status === 404) switchedOff = true;
      else errors = { ...error.fields };
    }
  }
  const [me, catalogue] = await Promise.all([api.me(), api.species()]);
  return { logged: false, birder: me.birder, species: catalogue.species, flags: catalogue.flags } as const;
});
if ('redirect' in page) return page.redirect;
if (page.loaded.logged) return Astro.redirect('/?logged', 303);
const { birder, species, flags } = page.loaded;
const formShown = flagOn(flags, 'new-sighting-form');
if (!formShown) Astro.response.status = 404;
---

<BirdwatchLayout title="Log a sighting" birder={birder}>
  <h1 class="ff-serif text-2xl">Log a sighting</h1>
  {
    formShown ? (
      <form method="post" class="stack" data-testid="new-sighting-form">
        <FormField label="Species" error={errors['speciesId']}>
          <Select name="speciesId" required>
            <option value="" selected={submitted.speciesId === ''}>
              Choose a species
            </option>
            {species.map((option) => (
              <option value={option.id} selected={option.id === submitted.speciesId}>
                {option.commonName} ({option.scientificName})
              </option>
            ))}
          </Select>
        </FormField>
        <FormField label="Where" error={errors['location']}>
          <Input name="location" value={submitted.location} required maxlength={120} />
        </FormField>
        <FormField label="How many" error={errors['count']}>
          <Input name="count" type="number" min="1" max="10000" step="1" value={submitted.count} required />
        </FormField>
        <FormField label="Notes" hint="Optional: behaviour, plumage, weather…" error={errors['notes']}>
          <Textarea name="notes" value={submitted.notes} maxlength={500} />
        </FormField>
        <Button type="submit" variant="primary">
          Log it
        </Button>
      </form>
    ) : (
      <Alert variant="warning" icon="triangle-alert" title="Logging sightings is switched off" data-testid="form-off">
        {switchedOff
          ? 'It was switched off before your sighting was sent, so it wasn’t logged.'
          : 'The new-sighting-form flag serves false right now.'}
      </Alert>
    )
  }
  <Button href="/" variant="muted" decoration="ghost">Back to the sightings</Button>
</BirdwatchLayout>
