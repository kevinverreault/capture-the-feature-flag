---
import Card from '@ds/components/ui/Card.astro';
import Button from '@ds/components/ui/Button.astro';
import Avatar from '@ds/components/ui/Avatar.astro';
import BirdwatchLayout from '../layouts/BirdwatchLayout.astro';
import { ApiError, birdwatchApi } from '../lib/api';
import { countryName } from '../lib/format';
import { startSession } from '../lib/session';

// The fake login: picking a birder gets a session token signed by birdwatch-api, kept in a cookie.
const api = birdwatchApi(Astro.locals);
if (Astro.request.method === 'POST') {
  const birderId = (await Astro.request.formData()).get('birderId');
  try {
    const session = await api.logIn(typeof birderId === 'string' ? birderId : '');
    startSession(Astro.cookies, session.token, session.expiresInSeconds);
    return Astro.redirect('/', 303);
  } catch (error) {
    // An unknown birder (a stale page) just shows the picker again.
    if (!(error instanceof ApiError && error.status === 404)) throw error;
  }
}

const { birders } = await api.birders();
---

<BirdwatchLayout title="Log in">
  <div>
    <h1 class="ff-serif text-2xl">Who’s birding today?</h1>
    <p class="muted">
      Pick a birder to log in as. There are no passwords: each birder has a user ID and a country, and their flags
      are evaluated for them.
    </p>
  </div>
  <ul class="cards">
    {
      birders.map((birder) => (
        <Card as="li">
          <div slot="header" class="birder">
            <Avatar name={birder.name} alt="" />
            <div>
              <h2 class="text-lg">{birder.name}</h2>
              <p class="muted text-sm">
                {countryName(birder.country)} · {birder.homePatch}
              </p>
            </div>
          </div>
          <form method="post" slot="footer">
            <input type="hidden" name="birderId" value={birder.id} />
            <Button type="submit" variant="primary">
              Log in as {birder.name.split(' ')[0]}
            </Button>
          </form>
        </Card>
      ))
    }
  </ul>
</BirdwatchLayout>

<style>
  .birder {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  form {
    margin: 0;
  }
</style>
