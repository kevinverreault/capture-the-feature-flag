---
import Alert from '@ds/components/feedback/Alert.astro';
import Button from '@ds/components/ui/Button.astro';
import SightingCard from '../components/SightingCard.astro';
import BirdwatchLayout from '../layouts/BirdwatchLayout.astro';
import { birdwatchFlags } from '@ctff/birdwatch-contract';
import { flagOn } from '../lib/api';
import { asBirder } from '../lib/page-session';

// The sighting feed. "Log a sighting" shows only while the new-sighting-form kill switch serves true, and
// "Photo ID (beta)" only to the birders photo-id-beta targets.
const page = await asBirder(Astro, (api) => api.sightings());
if ('redirect' in page) return page.redirect;
const { birder, sightings, flags } = page.loaded;
const canLogSightings = flagOn(flags, birdwatchFlags.newSightingForm);
const canUsePhotoId = flagOn(flags, birdwatchFlags.photoIdBeta);
const justLogged = Astro.url.searchParams.has('logged');
---

<BirdwatchLayout title="Sightings" page={page.loaded}>
  {
    justLogged && (
      <Alert variant="success" icon="circle-check">
        Sighting logged. Thanks, {birder.name.split(' ')[0]}!
      </Alert>
    )
  }
  <div class="page-heading">
    <h1 class="ff-serif text-2xl">Recent sightings</h1>
    <div class="actions">
      {
        canUsePhotoId && (
          <Button href="/photo-id" variant="secondary" data-testid="photo-id">
            Photo ID (beta)
          </Button>
        )
      }
      {
        canLogSightings && (
          <Button href="/sightings/new" variant="primary" data-testid="log-sighting">
            Log a sighting
          </Button>
        )
      }
    </div>
  </div>
  <ul class="cards">
    {sightings.map((sighting) => <SightingCard sighting={sighting} />)}
  </ul>
</BirdwatchLayout>
