---
import Badge from '@ds/components/ui/Badge.astro';
import Card from '@ds/components/ui/Card.astro';
import type { FeedSighting, Rarity } from '../lib/api';
import { countryName, formatObservedAt } from '../lib/format';

interface Props {
  sighting: FeedSighting;
}

const { sighting } = Astro.props;
const rarityBadge: Record<Rarity, 'danger' | 'secondary' | 'muted'> = {
  rare: 'danger',
  uncommon: 'secondary',
  common: 'muted',
};
---

<Card as="li" data-testid="sighting">
  <div slot="header">
    <div class="title">
      <h2 class="text-lg">{sighting.species.commonName}</h2>
      <Badge variant={rarityBadge[sighting.species.rarity]}>{sighting.species.rarity}</Badge>
    </div>
    <p class="muted text-sm"><em>{sighting.species.scientificName}</em></p>
  </div>
  <p>
    <strong>{sighting.count}</strong> at {sighting.location}
  </p>
  {sighting.notes && <p class="notes">{sighting.notes}</p>}
  <p slot="footer" class="muted text-sm">
    {sighting.birder.name} ({countryName(sighting.birder.country)}) ·
    <time datetime={sighting.observedAt}>{formatObservedAt(sighting.observedAt)}</time>
  </p>
</Card>

<style>
  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs);
  }

  .notes {
    margin-top: var(--space-xs);
    font-style: italic;
  }
</style>
