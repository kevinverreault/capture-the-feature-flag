          },
          "counts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvaluationCountDto"
            }
          },
          "seenContexts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SeenContextDto"
            }
          }
        },
        "required": [
          "sdkKey",
          "counts",
          "seenContexts"
        ]
      },
      "TelemetryBatchDto": {
        "type": "object",
        "properties": {
          "environments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnvironmentTelemetryDto"
            }
          }
        },
        "required": [
          "environments"
        ]
      },
      "SettingsDto": {
        "type": "object",
        "properties": {
          "metricRetentionDays": {
            "type": "integer",
            "description": "How many days evaluation count buckets are kept.",
            "minimum": 1,
            "maximum": 3650
          },
          "seenContextRetentionDays": {
            "type": "integer",
            "description": "How many days a seen context is kept after it was last seen.",
            "minimum": 1,
            "maximum": 3650
          },
          "seenContextCap": {
            "type": "integer",
            "description": "How many seen contexts are kept per environment: the most recently seen.",
            "minimum": 1,
            "maximum": 100000
          },
          "staleFlagThresholdDays": {
            "type": "integer",
            "description": "After how many days without evaluations in any environment a flag counts as stale.",
            "minimum": 1,
            "maximum": 3650
          }
        },
        "required": [
          "metricRetentionDays",
          "seenContextRetentionDays",
          "seenContextCap",
          "staleFlagThresholdDays"
        ]
      },
      "UpdateSettingsDto": {
        "type": "object",
        "properties": {
          "metricRetentionDays": {
            "type": "integer",
            "description": "How many days evaluation count buckets are kept.",
            "minimum": 1,
            "maximum": 3650
          },
          "seenContextRetentionDays": {
            "type": "integer",
            "description": "How many days a seen context is kept after it was last seen.",
            "minimum": 1,
            "maximum": 3650
          },
          "seenContextCap": {
            "type": "integer",
            "description": "How many seen contexts are kept per environment: the most recently seen.",
            "minimum": 1,
            "maximum": 100000
          },
          "staleFlagThresholdDays": {
            "type": "integer",
            "description": "After how many days without evaluations in any environment a flag counts as stale.",
            "minimum": 1,
            "maximum": 3650
          }
        }
      },
      "EvaluationCountBucketDto": {
        "type": "object",
        "properties": {
          "flagKey": {
            "type": "string",
            "example": "rare-bird-alerts"
          },
          "environmentKey": {
            "type": "string",
            "example": "production"
          },
          "variationIndex": {
            "type": "number",
            "description": "Index into the flag variations."
          },
          "minute": {
            "format": "date-time",
            "type": "string",
            "description": "The start of the minute."
          },
          "count": {
            "type": "number"
          }
        },
        "required": [
          "flagKey",
          "environmentKey",
          "variationIndex",
          "minute",
          "count"
        ]
      },
      "StoredSeenContextDto": {
        "type": "object",
        "properties": {
          "context": {
            "description": "Its context attributes; `country` in uppercase.",
            "allOf": [
              {
                "$ref": "#/components/schemas/ContextDto"
              }
            ]
          },
          "lastSeen": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "context",
          "lastSeen"
        ]
      }
    }
  }
}
