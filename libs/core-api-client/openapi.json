  "info": {
    "title": "Capture The Feature Flag Core API",
    "description": "Projects, environments, flags and targeting, and the endpoints Evaluators poll.",
    "version": "v1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ProjectDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "example": "birdwatch"
          },
          "name": {
            "type": "string",
            "example": "Birdwatch"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "key",
          "name",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The project key: lowercase kebab-case, immutable after creation.",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64,
            "example": "rare-bird-alerts"
          },
          "name": {
            "type": "string",
            "description": "The project's display name.",
            "maxLength": 200
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "UpdateProjectDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The current project key, if sent. It cannot be changed."
          },
          "name": {
            "type": "string",
            "description": "The project's display name.",
            "maxLength": 200
          }
        }
      },
      "EnvironmentDto": {
        "type": "object",
        "properties": {
          "projectKey": {
            "type": "string",
            "example": "birdwatch"
          },
          "key": {
            "type": "string",
            "example": "production"
          },
          "name": {
            "type": "string",
            "example": "Production"
          },
          "sdkKey": {
            "type": "string",
            "description": "The opaque, generated key an SDK uses to say which environment it evaluates in.",
            "example": "ctff-env-3q2xJ0bS9yqgk1WkR7cN5hTzL0aV"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "projectKey",
          "key",
          "name",
          "sdkKey",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateEnvironmentDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The environment key: lowercase kebab-case, immutable after creation.",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64,
            "example": "rare-bird-alerts"
          },
          "name": {
            "type": "string",
            "description": "The environment's display name.",
            "maxLength": 200
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "UpdateEnvironmentDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The current environment key, if sent. It cannot be changed."
          },
          "sdkKey": {
            "type": "string",
            "description": "The current SDK key, if sent. It cannot be changed."
          },
          "name": {
            "type": "string",
            "description": "The environment's display name.",
            "maxLength": 200
          }
        }
      },
      "FlagDto": {
        "type": "object",
        "properties": {
          "projectKey": {
            "type": "string",
            "example": "birdwatch"
          },
          "key": {
            "type": "string",
            "example": "rare-bird-alerts"
          },
          "name": {
            "type": "string",
            "example": "Rare bird alerts"
          },
          "description": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variations": {
            "example": [
              true,
              false
            ],
            "description": "The ordered variations; targeting refers to them by index. Boolean flags are always [true, false].",
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          "version": {
            "type": "number",
            "description": "Incremented on every edit; send it back with the next edit."
          },
          "createdAt": {
            "format": "date-time",
            "type": "string"
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "projectKey",
          "key",
          "name",
          "description",
          "tags",
          "variations",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateFlagDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "The flag key: lowercase kebab-case, immutable after creation.",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
            "maxLength": 64,
            "example": "rare-bird-alerts"
          },
          "name": {
            "type": "string",
            "description": "The flag's display name.",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "description": "What the flag controls."
          },
          "tags": {
            "example": [
              "alerts"
            ],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "key",
          "name"
        ]
      },
      "UpdateFlagDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "The version this edit is based on. An outdated version is rejected with 409."
          },
          "key": {
            "type": "string",
            "description": "The current flag key, if sent. It cannot be changed."
          },
          "name": {
            "type": "string",
            "description": "The flag's display name.",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "description": "What the flag controls."
          },
          "tags": {
            "example": [
              "alerts"
            ],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "version"
        ]
      },
      "IndividualTargetDto": {
        "type": "object",
        "properties": {
          "variation": {
            "type": "number",
            "description": "Index into the flag variations."
          },
          "userIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "variation",
          "userIds"
        ]
      },
      "RuleDto": {
        "type": "object",
        "properties": {
          "attribute": {
            "type": "string",
            "enum": [
              "user_id",
              "country"
            ]
          },
          "operator": {
            "type": "string",
            "enum": [
              "in",
              "not_in"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "variation": {
            "type": "number",
            "description": "Index into the flag variations."
          }
        },
        "required": [
          "attribute",
          "operator",
          "values",
          "variation"
        ]
      },
      "TargetingDto": {
        "type": "object",
        "properties": {
          "flagKey": {
            "type": "string",
            "example": "rare-bird-alerts"
          },
          "environmentKey": {
            "type": "string",
            "example": "production"
          },
          "on": {
            "type": "boolean",
            "description": "Targeting on or off. While off, every context gets the off variation."
          },
          "offVariation": {
            "type": "number",
            "description": "Index into the flag variations served while targeting is off."
          },
          "defaultVariation": {
            "type": "number",
            "description": "Index into the flag variations served when no individual target or rule matches."
          },
          "individualTargets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndividualTargetDto"
            }
          },
          "rules": {
            "description": "Ordered; the first rule that matches wins.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleDto"
            }
          },
          "version": {
            "type": "number",
            "description": "Incremented on every change; send it back with the next change."
          },
          "updatedAt": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "flagKey",
          "environmentKey",
          "on",
          "offVariation",
          "defaultVariation",
          "individualTargets",
          "rules",
          "version",
          "updatedAt"
        ]
      },
      "UpdateTargetingDto": {
        "type": "object",
        "properties": {
          "version": {
            "type": "number",
            "description": "The version this change is based on. An outdated version is rejected with 409."
          },
          "on": {
            "type": "boolean",
            "description": "Switch targeting on or off."
          }
        },
        "required": [
          "version"
        ]
      },
      "EnvironmentListEntryDto": {
        "type": "object",
        "properties": {
          "projectKey": {
            "type": "string",
            "example": "birdwatch"
          },
          "environmentKey": {
            "type": "string",
            "example": "production"
          },
          "sdkKey": {
            "type": "string",
            "example": "ctff-env-…"
          }
        },
        "required": [
          "projectKey",
          "environmentKey",
          "sdkKey"
        ]
      },
      "EnvironmentListDto": {
        "type": "object",
        "properties": {
          "environments": {
            "description": "Every environment of every project, by SDK key.",
