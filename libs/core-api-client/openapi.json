      "TargetingSnapshotDto": {
        "type": "object",
        "properties": {
          "on": {
            "type": "boolean"
          },
          "offVariation": {
            "type": "number"
          },
          "defaultVariation": {
            "type": "number"
          },
          "individualTargets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IndividualTargetDto"
            }
          },
          "rules": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RuleDto"
            }
          },
          "version": {
            "type": "number"
          }
        },
        "required": [
          "on",
          "offVariation",
          "defaultVariation",
          "individualTargets",
          "rules",
          "version"
        ]
      },
      "FlagSnapshotDto": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "variations": {
            "type": "array",
            "items": {
              "type": "boolean"
            }
          },
          "version": {
            "type": "number"
          },
          "targeting": {
            "$ref": "#/components/schemas/TargetingSnapshotDto"
          }
        },
        "required": [
