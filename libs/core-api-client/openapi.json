          "projectKey": {
            "type": "string"
          },
          "environmentKey": {
            "type": "string"
          },
          "flags": {
            "description": "Every flag of the project, ordered by flag key.",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlagSnapshotDto"
            }
          }
        },
        "required": [
          "projectKey",
          "environmentKey",
          "flags"
        ]
      },
      "EvaluationCountDto": {
        "type": "object",
        "properties": {
          "flagKey": {
            "type": "string",
            "example": "rare-bird-alerts"
          },
          "variationIndex": {
            "type": "integer",
            "description": "Index into the flag variations.",
            "minimum": 0
          },
          "minute": {
            "type": "string",
            "description": "The start of the minute; seconds are ignored.",
            "example": "2026-11-15T12:34:00.000Z"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000
          }
        },
        "required": [
          "flagKey",
          "variationIndex",
          "minute",
          "count"
        ]
      },
      "ContextDto": {
        "type": "object",
        "properties": {
          "user_id": {
            "type": "string",
            "description": "Any non-empty string.",
            "example": "alice"
          },
          "country": {
            "type": "string",
            "description": "An ISO 3166-1 alpha-2 code, in any case.",
            "example": "CA"
          }
        }
      },
      "SeenContextDto": {
        "type": "object",
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ContextDto"
          },
          "lastSeen": {
            "type": "string",
            "example": "2026-11-15T12:34:56.789Z"
          }
        },
        "required": [
          "context",
          "lastSeen"
        ]
      },
      "EnvironmentTelemetryDto": {
        "type": "object",
        "properties": {
          "sdkKey": {
            "type": "string",
