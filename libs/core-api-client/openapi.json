    "/api/v1/evaluator/snapshot": {
      "get": {
        "operationId": "EvaluatorController_snapshot",
        "parameters": [
          {
            "name": "If-None-Match",
            "in": "header",
            "description": "The ETag of the snapshot already held.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-ctff-sdk-key",
            "in": "header",
            "description": "The SDK key of the environment.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The targeting of every flag in the SDK key's environment, with an ETag.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnvironmentSnapshotDto"
                }
              }
            }
          },
          "304": {
            "description": "The snapshot has not changed since the ETag in If-None-Match."
          },
          "400": {
            "description": "No x-ctff-sdk-key header."
          },
          "404": {
            "description": "Unknown SDK key."
          }
        },
        "tags": [
          "evaluator"
        ]
      }
    }
