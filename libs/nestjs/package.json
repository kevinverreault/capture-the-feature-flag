{
  "name": "@ctff/nestjs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The NestJS module: configures @ctff/sdk, and adds an injectable CtffClient, the @Flags() parameter decorator and the @RequireFlag guard.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint ."
  },
  "nx": {
    "tags": [
      "type:lib",
      "scope:shared"
    ]
  },
  "dependencies": {
    "@ctff/sdk": "workspace:*"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3"
  }
}
